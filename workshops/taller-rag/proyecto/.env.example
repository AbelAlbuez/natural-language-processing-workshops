# Copie este archivo como .env (Mac/Linux: cp .env.example .env | Windows: copy .env.example .env)
# No contiene secretos.

# --- Aplicación (contenedores api y frontend) ---
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=rag_e5s_tok256_v1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
OLLAMA_URL=http://ollama:11434
LLM_MODEL=gemma2:2b
MAX_CONTEXT_CHARS=8500
# Lista de modelos que la API acepta y la interfaz ofrece (separados por comas).
LLM_MODELS=gemma2:2b,qwen2.5:1.5b,llama3.2:1b,llama3.2:3b
# Orquestación RAG (app/rag.py).
RAG_TOP_K=5
# Provisional: calibrar con las preguntas de desarrollo antes de fijar el valor.
RAG_SCORE_THRESHOLD=0.80
RAG_MAX_CONTEXT_TOKENS=2048
RAG_RUN_LOG=reports/rag_runs.jsonl

# --- Versiones fijadas (reproducibilidad) ---
MILVUS_VERSION=v2.6.25
OLLAMA_VERSION=0.40.13

# --- Límites de recursos por contenedor ---
# Valores pensados para un equipo con 16 GB de RAM. Con 8 GB, use MILVUS_MEM=2g,
# OLLAMA_MEM=4g y modelos de 1-2B; llama3.2:3b necesita unos 4 GB para Ollama.
MILVUS_CPUS=2
MILVUS_MEM=4g
OLLAMA_CPUS=4
OLLAMA_MEM=6g
OLLAMA_KEEP_ALIVE=10m
API_CPUS=2
API_MEM=3g

# --- Preparación del corpus (servicio prep) ---
LANGUAGES=es en

# --- Variables para scripts locales (fuera de Docker) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
OLLAMA_HOST=http://localhost:11434
CORPUS_PATH=data/documentos_rag.parquet
TOP_K=5
