# Regenerables con ./run.sh y demasiado grandes para git.
resultados*/prepared.parquet
resultados*/**/theta.npy
resultados*/theta.npy
resultados*/**/embeddings.npy
resultados*/**/asignacion_seed*.npz
# Modelos: sólo el final de cada corpus, el diccionario y Phrases.
resultados/modelos/*
!resultados/modelos/lda_k15.model
!resultados/modelos/lda_k15.model.*
!resultados/modelos/dictionary.dict
!resultados/modelos/phrases.pkl
resultados_publico/modelos/*
!resultados_publico/modelos/lda_k25.model
!resultados_publico/modelos/lda_k25.model.*
!resultados_publico/modelos/ensemble_seed42_eps0.3.model
!resultados_publico/modelos/ensemble_seed42_eps0.3.model.*
!resultados_publico/modelos/dictionary.dict
!resultados_publico/modelos/phrases.pkl
# Emparejamiento entre medios: aristas y vecinos se regeneran con eventos.py.
resultados*/eventos/aristas.parquet
resultados*/eventos/mejores.npz
resultados*/eventos/mejor_par.npy
