# Copiar a .env y ajustar. NUNCA versionar .env (CLAUDE.md §20).

# ── Base de datos ────────────────────────────────────────────────────────────
DB_USER=news_corpus
DB_PASSWORD=news_corpus
DB_NAME=news_corpus
DB_HOST=localhost
DB_PORT=5433          # puerto publicado por docker-compose (5432 suele estar ocupado)
DB_PORT_HOST=5433

# ── JupyterLab (servicio "jupyter" de docker-compose) ────────────────────────
JUPYTER_PORT=8888
JUPYTER_TOKEN=news-corpus

# ── Configuración externa ────────────────────────────────────────────────────
CONFIG_DIR=config

# ── Adquisición ──────────────────────────────────────────────────────────────
CORPUS_START=2006-08-07
CORPUS_END=2026-08-07
ENABLED_PROVIDERS=sitemap

# ── Red ──────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SEC=45
MAX_RETRIES=5
USER_AGENT=news-corpus-research/0.1 (proyecto academico NLP; contacto: cambiar@ejemplo.edu)

# ── Rate limiting por proveedor (peticiones por segundo) ─────────────────────
# GDELT: medido en Fase 1. A 1 req/25s sólo respondió el 38% de las consultas.
# 0.04 req/s = 1 cada 25 s. Subirlo degrada la tasa de éxito.
RATE_SITEMAP=1.0
RATE_GDELT=0.04
RATE_COMMON_CRAWL=0.2
RATE_WAYBACK=0.2

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console     # console | json
